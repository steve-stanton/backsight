<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Backsight.Editor.Map.MapWindow"
        Title="MapWindow">
    <Grid>
        <mapsui:MapControl x:Name="MapControl">
            <mapsui:MapControl.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="Command 1" Click="OnClick1" />
                    <MenuItem Header="Command 2" Click="OnClick2" />
                </MenuFlyout>
            </mapsui:MapControl.ContextFlyout>
            <mapsui:MapControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Command 1a" Click="OnClick1" />
                    <MenuItem Header="Command 2a" Click="OnClick2" />
                </ContextMenu>
            </mapsui:MapControl.ContextMenu>
        </mapsui:MapControl>
        <Canvas x:Name="MapOverlay"
                Background="Transparent"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
