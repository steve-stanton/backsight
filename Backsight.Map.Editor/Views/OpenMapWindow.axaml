<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Backsight.Map.Editor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Backsight.Map.Editor.Views.OpenMapWindow"
        x:DataType="vm:OpenMapViewModel"
        Title="OpenMapWindow">

  <Grid>
    <ListBox
        ItemsSource="{Binding MapNames}"
        SelectedItem="{Binding SelectedMapName}"
        Height="300"
        SelectionMode="Single" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="40">
        <Button
            Content="OK"
            HorizontalContentAlignment="Center"
            Height="32"
            Width="100"
            Margin="10"
            Command="{Binding OkCommand}" />
        <Button
            Content="Cancel"
            HorizontalContentAlignment="Center"
            Height="32"
            Width="100"
            Margin="10"
            Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>

</Window>
