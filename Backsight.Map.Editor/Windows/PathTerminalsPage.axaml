<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:me="clr-namespace:Backsight.Map.Editor.Windows" x:DataType="me:PathTerminalsViewModel"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="170"
        MinWidth="340" MinHeight="170"
        x:Class="Backsight.Map.Editor.Windows.PathTerminalsPage">

    <UserControl.Resources>
        <me:FeatureIdConverter x:Key="FeatureIdConverter"/>
    </UserControl.Resources>
        
    <Grid RowDefinitions="Auto Auto" ColumnDefinitions="90 Auto 120" RowSpacing="20" ColumnSpacing="20" Margin="20">
        
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Start point" VerticalAlignment="Center"/>
        <me:PickButton Grid.Row="0" Grid.Column="1"
            Height="32"
            BorderBrush="Blue"
            BorderThickness="4"
            ToolTip.Tip="Pick the starting point from the map"
            Command="{Binding PickStartCommand}"/>
        <TextBox Grid.Row="0" Grid.Column="2"
            Height="32"
            ToolTip.Tip="Use the picker to select a point from the map"
            IsReadOnly="True"
            Text="{Binding SelectedStart, Converter={StaticResource FeatureIdConverter}}"/>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="End point" VerticalAlignment="Center"/>
        <me:PickButton Grid.Row="1" Grid.Column="1"
            Height="32"
            BorderBrush="Aqua"
            BorderThickness="4"
            ToolTip.Tip="Pick the end point from the map"
            Command="{Binding PickEndCommand}"/>
        <TextBox Grid.Row="1" Grid.Column="2"
            Height="32"
            ToolTip.Tip="Use the picker to select a point from the map"
            IsReadOnly="True"
            Text="{Binding SelectedEnd, Converter={StaticResource FeatureIdConverter}}"/>
        
    </Grid>
    
</UserControl>