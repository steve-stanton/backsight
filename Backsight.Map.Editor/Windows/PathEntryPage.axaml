<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:me="clr-namespace:Backsight.Map.Editor.Windows" x:DataType="me:PathEntryViewModel"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="280"
             MinWidth="450" MinHeight="280"
             x:Class="Backsight.Map.Editor.Windows.PathEntryPage">
    
    <Grid RowDefinitions="Auto Auto Auto Auto Auto" RowSpacing="10" Margin="20" ColumnDefinitions="Auto 100">
        <TextBox Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                 TabIndex="0" MinWidth="300" Margin="0 0 20 0"
                 Text="{Binding Text}"/>

        <Button Grid.Row="0" Grid.Column="1"
                Command="{Binding DistanceCommand}"
                IsTabStop="False" Content="_Distance..." Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" MinWidth="100"/>
        <Button Grid.Row="1" Grid.Column="1"
                Command="{Binding AngleCommand}"
                IsTabStop="False" Content="_Angle..." Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" MinWidth="100"/>
        <Button Grid.Row="2" Grid.Column="1"
                Command="{Binding CurveCommand}"
                IsTabStop="False" Content="_Curve..." Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" MinWidth="100"/>
        <Button Grid.Row="3" Grid.Column="1" 
                Command="{Binding CuldeSacCommand}"
                IsTabStop="False" Content="Cul de _sac..." Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" MinWidth="100"/>
        <Button Grid.Row="4" Grid.Column="1" 
                Command="{Binding EndCurveCommand}"
                IsTabStop="False" Content="_End Curve" Height="40"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" MinWidth="100"/>
        
    </Grid>
</UserControl>
