<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:Backsight.Map.Editor.Windows"
        x:DataType="viewModel:SimpleLineSubdivisionViewModel"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="180"
        Width="420" Height="180"
        CanResize="False"
        x:Class="Backsight.Map.Editor.Windows.SimpleLineSubdivisionWindow"
        Title="Subdivide Line">
    
    <Grid RowDefinitions="Auto Auto Auto" Margin="20" >
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20">
            <TextBlock Text="Distance to split point" VerticalAlignment="Center"/>
            <NumericUpDown 
                TabIndex="0"
                Width="100"
                AllowSpin="False"
                ShowButtonSpinner="False"
                Value="{Binding Distance}"
                InnerRightContent="{Binding Units}"
                VerticalContentAlignment="Center"
                Minimum="0.0001"/>
            <Button Grid.Row="1"
                IsTabStop="False"
                Content="_Other Way"
                Command="{Binding OtherWayCommand}"
                HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBox Grid.Row="1"
            Text="{Binding TooLongMessage}"
            BorderBrush="Transparent"
            Margin="0 10 0 0"
            Height="16"
            IsVisible="{Binding TooLong}"
            VerticalContentAlignment="Center">
            <TextBox.InnerLeftContent>
                <PathIcon
                    Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                    Foreground="Red"/>
            </TextBox.InnerLeftContent>
        </TextBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
            <Button
                Content="OK"
                IsDefault="True"
                FontWeight="Bold"
                HorizontalContentAlignment="Center"
                Height="32"
                Width="100"
                Margin="10"
                Command="{Binding OkCommand}" />
            <Button
                Content="Cancel"
                IsCancel="True"
                HorizontalContentAlignment="Center"
                Height="32"
                Width="100"
                Margin="10"
                Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
    
</Window>