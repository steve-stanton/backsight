<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:Backsight.Map.Editor.Windows" x:DataType="viewModel:NewPointViewModel"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="300"
        x:Class="Backsight.Map.Editor.Windows.NewPointWindow"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        SizeToContent="WidthAndHeight"
        Title="NewPointWindow">
        
    <GroupBox Header="Define New Point" BorderBrush="Brown" BorderThickness="4" CornerRadius="4" Margin="5" Padding="10">
        <Grid RowDefinitions="Auto Auto Auto Auto" ColumnDefinitions="Auto Auto Auto Auto" RowSpacing="20" ColumnSpacing="10"
              Margin="20">
            
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Northing" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                AllowSpin="False"
                ShowButtonSpinner="False"
                Value="{Binding Northing}"
                VerticalContentAlignment="Center"
                TabIndex="0"
                MinWidth="150"
                Minimum="100000"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Easting" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                AllowSpin="False"
                ShowButtonSpinner="False"
                Value="{Binding Easting}"
                VerticalContentAlignment="Center"
                TabIndex="1"
                MinWidth="150"
                Minimum="100000"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Elevation" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                AllowSpin="False"
                ShowButtonSpinner="False"
                Value="{Binding Elevation}"
                TabIndex="2"
                MinWidth="150"
                VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Entity type" VerticalAlignment="Center" Margin="40 0 0 0"/>
            <ComboBox Grid.Row="0" Grid.Column="3"
                ItemsSource="{Binding PointTypes}"
                SelectedItem="{Binding SelectedPointType}"
                MinWidth="300"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="ID" VerticalAlignment="Center" Margin="40 0 0 0"/>
            <ComboBox Grid.Row="1" Grid.Column="3"
                ItemsSource="{Binding PointIds}" 
                SelectedItem="{Binding SelectedPointId}"
                MinWidth="300"/>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button
                    Content="OK"
                    IsDefault="True"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    Height="32"
                    Width="100"
                    Margin="10"
                    Command="{Binding OkCommand}" />
                <Button
                    Content="Cancel"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    Height="32"
                    Width="100"
                    Margin="10"
                    Command="{Binding CancelCommand}" />
            </StackPanel>
            
        </Grid>
    </GroupBox>
    
</Window>