<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:me="clr-namespace:Backsight.Map.Editor.Windows" x:DataType="me:NewCircleViewModel"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="210"
        Width="340" Height="210"
        CanResize="False"
        x:Class="Backsight.Map.Editor.Windows.NewCircleWindow"
        Title="New Circle">

    <Window.Resources>
        <me:FeatureIdConverter x:Key="FeatureIdConverter"/>
    </Window.Resources>
        
    <Grid RowDefinitions="Auto Auto Auto" ColumnDefinitions="90 Auto 120" RowSpacing="20" ColumnSpacing="20" Margin="20">
        
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Center point" VerticalAlignment="Center"/>
        <me:PickButton Grid.Row="0" Grid.Column="1"
            Height="32"
            BorderBrush="DarkGray"
            BorderThickness="4"
            ToolTip.Tip="Pick the center point from the map"
            Command="{Binding PickCenterCommand}"/>
        <TextBox Grid.Row="0" Grid.Column="2"
            Height="32"
            ToolTip.Tip="Use the picker to select a point from the map"
            IsReadOnly="True"
            Text="{Binding SelectedCenter, Converter={StaticResource FeatureIdConverter}}"/>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius" VerticalAlignment="Center"/>
        <me:PickButton Grid.Row="1" Grid.Column="1"
            Height="32"
            BorderBrush="Green"
            BorderThickness="4"
            ToolTip.Tip="Pick a point on the circumference"
            Command="{Binding PickRadiusCommand}"/>
        <TextBox Grid.Row="1" Grid.Column="2"
            Height="32"
            ToolTip.Tip="Use the picker to select a point from the map"
            IsReadOnly="True"
            Text="{Binding SelectedRadius, Converter={StaticResource FeatureIdConverter}}"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
            <Button
                Content="OK"
                IsDefault="True"
                FontWeight="Bold"
                HorizontalContentAlignment="Center"
                Height="32"
                Width="100"
                Margin="10"
                Command="{Binding OkCommand}" />
            <Button
                Content="Cancel"
                IsCancel="True"
                HorizontalContentAlignment="Center"
                Height="32"
                Width="100"
                Margin="10"
                Command="{Binding CancelCommand}" />
        </StackPanel>
        
    </Grid>
</Window>