<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:Backsight.Map.Editor.Windows" x:DataType="viewModel:SessionOperationsViewModel"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="420"
        Width="750" Height="420"
        x:Class="Backsight.Map.Editor.Windows.SessionOperationsWindow"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Title="SessionWindow">
    
    <GroupBox Header="Session History" BorderBrush="Brown" BorderThickness="4" CornerRadius="4" Margin="5" Padding="10">
        <Grid RowDefinitions="* Auto">
            <TableView Grid.Row="0" ItemsSource="{Binding Edits}">
                <TableView.Columns>
                    <TableViewColumn Header="Edit Sequence" Binding="{Binding Sequence}"/>
                    <TableViewColumn Header="Edit Type" Binding="{Binding Type}" Width="3*"/>
                    <TableViewColumn Header="Feature Count" Binding="{Binding FeatureCount}"/>
                </TableView.Columns>
            </TableView>

            <Button Grid.Row="1"
                Content="Close"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"
                Height="32"
                Width="100"
                Margin="10"
                Command="{Binding OkCommand}" />
        </Grid>
    </GroupBox>
</Window>